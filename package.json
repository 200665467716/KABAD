{
  "name": "kabad",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:e2e": "playwright test",
    "licenses": "node tools/check-licenses.mjs",
    "realtime": "node realtime/server.mjs",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:seed": "prisma db seed",
    "postinstall": "prisma generate",
    "test:integration": "vitest run --project integration",
    "admin:promote": "tsx scripts/promote-admin.ts",
    "messages": "node tools/check-messages.mjs",
    "presentation:video": "node scripts/record-presentation.mjs",
    "worker": "node --env-file-if-exists=.env --import tsx worker/index.ts",
    "build:worker": "esbuild worker/index.ts --bundle --platform=node --target=node22 --format=esm --outfile=dist/worker.mjs --packages=external --alias:@=./src --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\""
  },
  "dependencies": {
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "bcryptjs": "3.0.3",
    "jose": "6.2.12",
    "livekit-client": "2.22.3",
    "next": "16.4.2",
    "next-intl": "4.14.9",
    "nodemailer": "10.0.16",
    "pg": "8.23.1",
    "pg-boss": "12.38.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "sharp": "file:./tools/no-sharp",
    "socket.io": "4.8.4",
    "socket.io-client": "4.8.4",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@tailwindcss/turbopack": "^4",
    "@types/node": "^22.20.5",
    "@types/nodemailer": "8.0.2",
    "@types/pg": "8.23.1",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "18.0.8",
    "esbuild": "0.28.2",
    "eslint": "^9",
    "eslint-config-next": "16.4.2",
    "license-checker-rseidelsohn": "^4.4.2",
    "prisma": "7.10.1",
    "tailwindcss": "^4",
    "tsx": "4.23.15",
    "typescript": "^5",
    "vitest": "^5.0.5"
  },
  "overrides": {
    "sharp": "$sharp"
  },
  "engines": {
    "node": ">=20.9"
  }
}
