# Copy to .env and adapt. Never commit real secrets.
DATABASE_URL="postgresql://kabad:kabad@127.0.0.1:5432/kabad"
# Shared by the web app and the realtime service to sign socket tokens (32+ random characters).
REALTIME_SECRET="change-me-to-a-long-random-string-0123456789"
# Where the browser reaches the realtime service.
NEXT_PUBLIC_REALTIME_URL="http://localhost:4001"
# Origins allowed to open a socket (the web app's URL).
REALTIME_ALLOWED_ORIGINS="http://localhost:3000"
REALTIME_PORT=4001
# Separate database for integration tests (emptied by the tests).
DATABASE_URL_TEST="postgresql://kabad:kabad@127.0.0.1:5432/kabad_test"
# Docker Compose only: password of the PostgreSQL container.
POSTGRES_PASSWORD="change-me"
# Public address of the web app (links in the e-mails).
APP_URL="http://localhost:3000"


# E-mails: account (address check, forgotten password) and important notifications, sent by the worker.
# Without SMTP_URL, in development, e-mails are printed in the terminal (npm run dev, npm run worker).
# With Gmail: turn on 2-step verification on the account, create an "app password"
# (https://myaccount.google.com/apppasswords) and write it without spaces; "@" becomes "%40".
# SMTP_URL="smtps://kabadteam%40gmail.com:app-password-16-letters@smtp.gmail.com:465"
# MAIL_FROM="KABAD <kabadteam@gmail.com>"
# Number of trusted reverse proxies in front of the app (production: 1 behind Caddy or Nginx). Local: 0.
TRUSTED_PROXY_HOPS=0

# Voice rooms: switched off for the CADEV. "on" shows them (needs the LiveKit values below, then a rebuild).
NEXT_PUBLIC_SALONS="off"
# LiveKit server (Apache-2.0), only when NEXT_PUBLIC_SALONS="on". Locally: livekit-server --dev (keys devkey / secret).
LIVEKIT_URL="http://localhost:7880"
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
