# Copy to .env and adapt. Never commit real secrets.
DATABASE_URL="postgresql://kabad:kabad@127.0.0.1:5432/kabad"
# Shared by the web app and the realtime service to sign socket tokens (32+ random characters).
REALTIME_SECRET="change-me-to-a-long-random-string-0123456789"
# Where the browser reaches the realtime service.
NEXT_PUBLIC_REALTIME_URL="http://localhost:4001"
# Origins allowed to open a socket (the web app's URL).
REALTIME_ALLOWED_ORIGINS="http://localhost:3000"
REALTIME_PORT=4001
# Separate database for integration tests (emptied by the tests).
DATABASE_URL_TEST="postgresql://kabad:kabad@127.0.0.1:5432/kabad_test"
# Docker Compose only: password of the PostgreSQL container.
POSTGRES_PASSWORD="change-me"
# Public address of the web app (redirect after GitHub sign-in).
APP_URL="http://localhost:3000"


# Sign in with GitHub (optional). Create an OAuth App: callback URL = APP_URL + /api/auth/github/callback
GITHUB_CLIENT_ID=""
GITHUB_CLIENT_SECRET=""

# Account e-mails (address check, forgotten password). Without it, in development, e-mails are printed in the terminal.
# SMTP_URL="smtps://user:password@smtp.example.org:465"
# MAIL_FROM="KABAD <no-reply@kabad.app>"
# Number of trusted reverse proxies in front of the app (production: 1 behind Caddy or Nginx). Local: 0.
TRUSTED_PROXY_HOPS=0

# Voice rooms: LiveKit server (Apache-2.0). Locally: livekit-server --dev (keys devkey / secret).
LIVEKIT_URL="http://localhost:7880"
NEXT_PUBLIC_LIVEKIT_URL="ws://localhost:7880"
LIVEKIT_API_KEY="devkey"
LIVEKIT_API_SECRET="secret"
