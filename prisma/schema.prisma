// KABAD data model: members, mentor badges, mentoring by time slots, hackathons and their prizes,
// community tests, messaging and Africa Rise-Up projects.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  JUNIOR
  SENIOR
}

/// Self-declared level, chosen at sign-up (profile step 1).
enum Level {
  ASPIRANT
  DEBUTANT
  INTERMEDIAIRE
  SENIOR
}

model User {
  id               String    @id @default(cuid())
  email            String    @unique
  /// Null for accounts created with GitHub only: they choose a password from their account page.
  passwordHash     String?
  /// Left by the GitHub sign-in, removed for the V1 (5 November 2026) and planned for the V2.
  /// Kept so that no account loses data; nothing writes them any more.
  githubId         Int?      @unique
  githubLogin      String?
  /// GitHub or LinkedIn profile, shown on the public profile.
  profileLink      String    @default("")
  isAdmin          Boolean   @default(false)
  /// Set when the KABAD team grants the mentor badge. Only badged mentors open slots and judge hackathons.
  seniorVerifiedAt DateTime?
  /// Set when the member types the code sent by e-mail. Until then they read but cannot contact anyone.
  emailVerifiedAt  DateTime?
  /// Set by a KABAD admin. A suspended member cannot sign in; their sessions are closed.
  suspendedAt      DateTime?
  /// Optional: only used to agree the texts about the member ("Vérifiée", "elle peut t'aider").
  gender           Gender?
  /// The member receives the important notifications by e-mail too (sessions, badge, invitations).
  emailNotifications Boolean @default(true)
  suspensionReason String?   @db.VarChar(300)
  name             String
  /// SENIOR once the mentor badge is granted, JUNIOR otherwise.
  role             Role      @default(JUNIOR)
  level            Level     @default(DEBUTANT)
  city             String    @default("")
  country          String    @default("")
  diaspora         Boolean   @default(false)
  years            Int       @default(0)
  headline         String    @default("")
  bio              String    @default("")
  stack            String[]  @default([])
  /// What the member came for: a mentor, hackathons, testers… (profile step 2).
  goals            String[]  @default([])
  /// Interface language, remembered across devices.
  locale           String    @default("fr") @db.VarChar(5)
  /// IANA time zone used to show slots and events at the member's local time.
  timeZone         String    @default("Africa/Lome") @db.VarChar(40)
  /// Video link a mentor uses for every session (Meet, Jitsi…). Empty: KABAD creates a Jitsi room per session.
  meetingUrl       String    @default("") @db.VarChar(200)
  /// When the profile photo last changed, or null without one. The address of the picture carries it, so browsers refresh it.
  photoAt          DateTime?
  createdAt        DateTime  @default(now())

  photo                UserPhoto?
  sessions             Session[]
  invitationsSent      Invitation[]         @relation("InvitationFrom")
  invitationsReceived  Invitation[]         @relation("InvitationTo")
  contacts             Contact[]            @relation("ContactOwner")
  contactOf            Contact[]            @relation("ContactTarget")
  memberships          ConversationMember[]
  messages             Message[]
  conversationsCreated Conversation[]       @relation("ConversationCreator")
  blocks               Block[]              @relation("Blocker")
  blockedBy            Block[]              @relation("Blocked")
  reports              Report[]
  badgeRequests        MentorBadgeRequest[] @relation("BadgeCandidate")
  badgeReviews         MentorBadgeRequest[] @relation("BadgeReviewer")
  availability         Availability[]
  blockedDates         BlockedDate[]
  bookingsAsMentor     MentoringBooking[]   @relation("BookingMentor")
  bookingsAsMentee     MentoringBooking[]   @relation("BookingMentee")
  hackathonsCreated    Hackathon[]
  juries               HackathonJuror[]
  teamsCaptained       Team[]
  teamSeats            TeamMember[]
  teamRequests         TeamJoinRequest[]
  missions             InstructorMission[]
  scores               JuryScore[]
  testApps             TestApp[]
  testSeats            TestParticipant[]
  testReports          TestReport[]
  riseProjects         RiseProject[]
  riseSeats            RiseMember[]
  risePosts            RisePost[]
  riseEvents           RiseEvent[]
  notifications        Notification[]
  emailTokens          EmailToken[]
  adminActions         AdminAction[]        @relation("AdminActor")
  reportsResolved      Report[]             @relation("ReportResolver")
  roomsHosted          VoiceRoom[]          @relation("RoomHost")
  roomSeats            RoomParticipant[]
  roomInterests        RoomInterest[]
}

/// The cookie holds a random token; only its SHA-256 is stored.
model Session {
  id        String   @id
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([userId])
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A first contact: one message of 300 characters at most. The conversation opens only once accepted.
model Invitation {
  id         String           @id @default(cuid())
  fromId     String
  toId       String
  from       User             @relation("InvitationFrom", fields: [fromId], references: [id], onDelete: Cascade)
  to         User             @relation("InvitationTo", fields: [toId], references: [id], onDelete: Cascade)
  message    String           @db.VarChar(300)
  status     InvitationStatus @default(PENDING)
  createdAt  DateTime         @default(now())
  answeredAt DateTime?

  @@unique([fromId, toId])
  @@index([toId, status])
}

/// Stored both ways (A→B and B→A) once an invitation is accepted.
model Contact {
  userId    String
  contactId String
  user      User     @relation("ContactOwner", fields: [userId], references: [id], onDelete: Cascade)
  contact   User     @relation("ContactTarget", fields: [contactId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, contactId])
}

enum ConversationKind {
  DIRECT
  GROUP
}

model Conversation {
  id            String           @id @default(cuid())
  kind          ConversationKind
  name          String?          @db.VarChar(60)
  /// Group theme shown as a tag: Fintech, Hackathon, Entraide…
  theme         String?          @db.VarChar(30)
  /// For DIRECT conversations: the two user ids sorted and joined, so a pair has one conversation only.
  directKey     String?          @unique
  createdById   String?
  createdBy     User?            @relation("ConversationCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt     DateTime         @default(now())
  lastMessageAt DateTime         @default(now())
  /// Set each time the group's photo changes: the address of the picture carries it, so browsers refresh it.
  photoAt       DateTime?
  /// What the group is about, shown in its info sheet.
  description   String?          @db.VarChar(300)

  members  ConversationMember[]
  messages Message[]
  testApp  TestApp?
  project  RiseProject?
  team     Team?
  photo    GroupPhoto?
  /// The group of a hackathon's paid instructors, run by its organizer.
  instructorsOf Hackathon?       @relation("HackathonInstructors")
}

/// The picture of a group. Kept in its own table so that listing conversations never loads its bytes.
model GroupPhoto {
  conversationId String       @id
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  mime           String       @db.VarChar(20)
  data           Bytes
}

/// The profile photo of a member, already cropped and reduced by the browser. In its own table so that loading a member never loads its bytes.
model UserPhoto {
  userId String @id
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  mime   String @db.VarChar(20)
  data   Bytes
}

enum Gender {
  FEMALE
  MALE
}

enum MemberRole {
  OWNER
  MEMBER
}

model ConversationMember {
  conversationId String
  userId         String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  role           MemberRole   @default(MEMBER)
  joinedAt       DateTime     @default(now())
  lastReadAt     DateTime     @default(now())

  @@id([conversationId, userId])
  @@index([userId])
}

enum MessageKind {
  TEXT
  SYSTEM
  /// A file or a voice note: the body holds an optional caption, the file is in Attachment.
  FILE
  VOICE
}

model Message {
  id             String       @id @default(cuid())
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  authorId       String?
  author         User?        @relation(fields: [authorId], references: [id], onDelete: SetNull)
  kind           MessageKind  @default(TEXT)
  body           String       @db.VarChar(4000)
  /// Sent by the client so that a retried send never creates a duplicate.
  clientId       String?
  createdAt      DateTime     @default(now())
  /// Hidden by the moderation team: the members see that a message was removed, not its content.
  hiddenAt       DateTime?
  attachment     Attachment?
  /// The message this one answers, quoted above it.
  replyToId      String?
  replyTo        Message?     @relation("Replies", fields: [replyToId], references: [id], onDelete: SetNull)
  replies        Message[]    @relation("Replies")
  /// Pinned by the group's owner: shown above the messages.
  pinnedAt       DateTime?

  @@unique([authorId, clientId])
  @@index([conversationId, createdAt])
  @@index([conversationId, pinnedAt])
}

/// A file sent in a conversation (PDF, image, voice note). Small files only (2 MB), kept in PostgreSQL
/// and served to the conversation's members only.
model Attachment {
  id        String  @id @default(cuid())
  messageId String  @unique
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)
  name      String  @db.VarChar(120)
  mime      String  @db.VarChar(80)
  size      Int
  /// Length of a voice note, in seconds.
  seconds   Int?
  data      Bytes
}

model Block {
  blockerId String
  blockedId String
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([blockerId, blockedId])
}

enum ReportTarget {
  ROOM
  USER
  MESSAGE
  CONVERSATION
  INVITATION
}

enum ReportStatus {
  OPEN
  REVIEWED
}

model Report {
  id           String       @id @default(cuid())
  reporterId   String
  reporter     User         @relation(fields: [reporterId], references: [id], onDelete: Cascade)
  /// The member the report is about, when there is one: lets the team see repeat offenders.
  targetUserId String?
  targetType   ReportTarget
  targetId     String
  reason       String       @db.VarChar(80)
  details      String?      @db.VarChar(1000)
  status       ReportStatus @default(OPEN)
  createdAt    DateTime     @default(now())
  resolvedAt   DateTime?
  resolvedById String?
  resolvedBy   User?        @relation("ReportResolver", fields: [resolvedById], references: [id], onDelete: SetNull)
  /// What the team decided, shown in the moderation history.
  resolution   String?      @db.VarChar(300)

  @@index([status, createdAt])
  @@index([targetUserId])
}

/**
 * Mentor badge: a member asks, the KABAD team checks the links and grants or refuses it.
 */

enum BadgeStatus {
  PENDING
  APPROVED
  REFUSED
}

model MentorBadgeRequest {
  id            String      @id @default(cuid())
  userId        String
  user          User        @relation("BadgeCandidate", fields: [userId], references: [id], onDelete: Cascade)
  /// Up to 3 areas: Backend, Mobile, Data et IA…
  domains       String[]
  technologies  String[]
  /// "3-5", "5-10" or "10+" years.
  experience    String      @db.VarChar(10)
  jobTitle      String      @db.VarChar(80)
  company       String?     @db.VarChar(80)
  githubUrl     String?     @db.VarChar(200)
  linkedinUrl   String?     @db.VarChar(200)
  portfolioUrl  String?     @db.VarChar(200)
  /// Public presentation, copied to the profile once granted.
  bio           String      @db.VarChar(280)
  /// What the mentor can help with.
  topics        String      @db.VarChar(300)
  status        BadgeStatus @default(PENDING)
  refusalReason String?     @db.VarChar(500)
  reviewedById  String?
  reviewedBy    User?       @relation("BadgeReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  createdAt     DateTime    @default(now())
  reviewedAt    DateTime?

  @@index([status, createdAt])
  @@index([userId, createdAt])
}

/**
 * Mentoring by time slots: a mentor opens weekly ranges, KABAD cuts them into 30-minute slots,
 * a member books one with a topic and a precise problem, the mentor accepts or declines.
 */

/// A weekly range in the mentor's time zone. weekday: 1 = Monday … 7 = Sunday; minutes from midnight.
model Availability {
  id       String @id @default(cuid())
  mentorId String
  mentor   User   @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  weekday  Int
  startMin Int
  endMin   Int

  @@index([mentorId, weekday])
}

/// A day off (travel, exams…): no slot is offered that day.
model BlockedDate {
  id       String   @id @default(cuid())
  mentorId String
  mentor   User     @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  day      DateTime @db.Date
  reason   String?  @db.VarChar(80)

  @@unique([mentorId, day])
}

enum BookingStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
}

/// One session of 30 minutes. A slot can carry only one PENDING or ACCEPTED booking
/// (partial unique index written in the migration).
model MentoringBooking {
  id            String        @id @default(cuid())
  mentorId      String
  menteeId      String
  mentor        User          @relation("BookingMentor", fields: [mentorId], references: [id], onDelete: Cascade)
  mentee        User          @relation("BookingMentee", fields: [menteeId], references: [id], onDelete: Cascade)
  startsAt      DateTime
  minutes       Int           @default(30)
  topic         String        @db.VarChar(120)
  problem       String        @db.VarChar(1000)
  link          String?       @db.VarChar(200)
  status        BookingStatus @default(PENDING)
  /// Set when the mentor accepts: their own link, or a Jitsi room created for the session.
  meetingUrl    String?       @db.VarChar(200)
  declineReason String?       @db.VarChar(300)
  createdAt     DateTime      @default(now())
  answeredAt    DateTime?
  /// The mentor was reminded of a request still waiting for an answer (worker).
  nudgedAt      DateTime?
  /// Both members were reminded one hour before the session (worker).
  remindedAt    DateTime?
  /// After the session, the dev rates it from 1 to 5, once, with an optional word for the mentor.
  rating        Int?
  ratingComment String?       @db.VarChar(300)
  ratedAt       DateTime?

  @@index([mentorId, startsAt])
  @@index([menteeId, startsAt])
  @@index([status, startsAt])
}

/**
 * Hackathons (the former code challenges) and their prizes
 */

enum HackathonStatus {
  OPEN
  JURY
  DONE
}

enum HackathonFormat {
  ONLINE
  ONSITE
  HYBRID
}

model Hackathon {
  id               String          @id
  title            String          @db.VarChar(120)
  /// Shown as "par FinLab Cotonou": a company, a school or a community.
  organizerName    String          @db.VarChar(80)
  createdById      String?
  createdBy        User?           @relation(fields: [createdById], references: [id], onDelete: SetNull)
  format           HackathonFormat
  city             String?         @db.VarChar(60)
  startsAt         DateTime
  endsAt           DateTime
  /// Registrations close at this date; solutions are due at endsAt.
  closesAt         DateTime
  /// 1 allows solo entries. teamMax 1: solo only.
  teamMin          Int             @default(1)
  teamMax          Int             @default(5)
  level            String          @db.VarChar(20)
  stack            String          @db.VarChar(60)
  /// The challenge to solve.
  description      String          @db.VarChar(2000)
  rulesUrl         String?         @db.VarChar(200)
  status           HackathonStatus @default(OPEN)
  resultsAt        DateTime?
  /// 0 to 5 prizes in free text, in the order of the ranking: the first goes to the first team, and so on (D12).
  /// KABAD holds no money: the organizer hands the prizes over.
  prizes           String[]        @default([])
  /// Instructor missions offered to KABAD mentors.
  missionText      String?         @db.VarChar(600)
  instructorFee    Int?
  instructorCount  Int             @default(0)
  /// Set by a moderator. Until then only its author and the team see it.
  publishedAt      DateTime?
  createdAt        DateTime        @default(now())

  jurors        HackathonJuror[]
  teams         Team[]
  submissions   Submission[]
  missions      InstructorMission[]
  /// The group where the organizer and the instructors who accepted a mission talk (opened at the first acceptance).
  instructorsConversationId String?       @unique
  instructorsConversation   Conversation? @relation("HackathonInstructors", fields: [instructorsConversationId], references: [id], onDelete: SetNull)

  @@index([status, startsAt])
}

model HackathonJuror {
  hackathonId String
  userId      String
  hackathon   Hackathon @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([hackathonId, userId])
}

/// Every entry is a team; a solo entry is a team of one.
model Team {
  id          String            @id @default(cuid())
  hackathonId String
  hackathon   Hackathon         @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  name        String            @db.VarChar(40)
  captainId   String
  captain     User              @relation(fields: [captainId], references: [id], onDelete: Cascade)
  solo        Boolean           @default(false)
  /// Open call shown to other participants: "Cherche un·e dev backend".
  lookingFor  String?           @db.VarChar(80)
  /// The team's discussion (H4): a group of the messaging that follows the team's members. Solo entries have none.
  conversationId String?        @unique
  conversation   Conversation?  @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now())
  members     TeamMember[]
  requests    TeamJoinRequest[]
  submission  Submission?

  @@unique([hackathonId, name])
}

model TeamMember {
  teamId      String
  userId      String
  /// Repeated from the team so that a member joins one team per hackathon (unique below).
  hackathonId String
  team        Team     @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Front, Mobile, Data…
  skill       String   @default("") @db.VarChar(30)
  joinedAt    DateTime @default(now())

  @@id([teamId, userId])
  @@unique([hackathonId, userId])
}

enum TeamRequestStatus {
  PENDING
  ACCEPTED
  DECLINED
}

/// A participant asks to join a team; the captain answers.
model TeamJoinRequest {
  id         String            @id @default(cuid())
  teamId     String
  userId     String
  team       Team              @relation(fields: [teamId], references: [id], onDelete: Cascade)
  user       User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  status     TeamRequestStatus @default(PENDING)
  /// False: the member asked to join, the captain answers. True: the captain invited the member, who answers (H3).
  invited    Boolean           @default(false)
  createdAt  DateTime          @default(now())
  answeredAt DateTime?

  @@unique([teamId, userId])
}

/// One solution per team, due at the end of the hackathon.
model Submission {
  id             String      @id @default(cuid())
  hackathonId    String
  teamId         String      @unique
  hackathon      Hackathon   @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  team           Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  projectName    String      @db.VarChar(60)
  repoUrl        String      @db.VarChar(200)
  demoUrl        String?     @db.VarChar(200)
  explanation    String      @db.VarChar(800)
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt
  scores         JuryScore[]

  @@index([hackathonId])
}

/// Each juror scores each solution on 4 criteria from 1 to 5.
model JuryScore {
  submissionId String
  jurorId      String
  submission   Submission @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  juror        User       @relation(fields: [jurorId], references: [id], onDelete: Cascade)
  works        Int
  code         Int
  tests        Int
  explain      Int
  comment      String?    @db.VarChar(1000)
  createdAt    DateTime   @default(now())

  @@id([submissionId, jurorId])
}

enum MissionStatus {
  PROPOSED
  ACCEPTED
  DECLINED
}

/// A paid instructor mission offered by the organizer to a badged mentor. KABAD records it;
/// the organizer pays the instructor directly.
model InstructorMission {
  id          String        @id @default(cuid())
  hackathonId String
  mentorId    String
  hackathon   Hackathon     @relation(fields: [hackathonId], references: [id], onDelete: Cascade)
  mentor      User          @relation(fields: [mentorId], references: [id], onDelete: Cascade)
  fee         Int
  status      MissionStatus @default(PROPOSED)
  createdAt   DateTime      @default(now())
  answeredAt  DateTime?

  @@unique([hackathonId, mentorId])
  @@index([mentorId, status])
}

/**
 * Community tests
 */

enum Platform {
  WEB
  ANDROID
  IOS
}

/// An app looking for testers. Joining opens its testers' group conversation, where the install link is shared.
model TestApp {
  id             String            @id @default(cuid())
  ownerId        String
  owner          User              @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  name           String            @db.VarChar(40)
  platforms      Platform[]
  url            String            @db.VarChar(300)
  minutes        Int
  slots          Int
  pitch          String            @db.VarChar(500)
  task           String            @db.VarChar(200)
  steps          String[]
  /// [{ q, options?, answer }]: control questions that prove the tester went through the app.
  questions      Json
  /// The testers' group, created with the app.
  conversationId String?           @unique
  conversation   Conversation?     @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  active         Boolean           @default(true)
  createdAt      DateTime          @default(now())
  participants   TestParticipant[]
  reports        TestReport[]

  @@index([active, createdAt])
}

/// A tester who joined an app's group, with the steps they ticked.
model TestParticipant {
  testAppId String
  userId    String
  testApp   TestApp  @relation(fields: [testAppId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Indexes of the steps done, from 0.
  doneSteps Int[]    @default([])
  joinedAt  DateTime @default(now())

  @@id([testAppId, userId])
  @@index([userId])
}

enum TestReportStatus {
  SUBMITTED
  VALIDATED
  REFUSED
}

model TestReport {
  id            String           @id @default(cuid())
  testAppId     String
  testerId      String
  testApp       TestApp          @relation(fields: [testAppId], references: [id], onDelete: Cascade)
  tester        User             @relation(fields: [testerId], references: [id], onDelete: Cascade)
  device        String           @db.VarChar(40)
  /// [{ question, answer, correct }]
  answers       Json
  remarks       String           @db.VarChar(2000)
  status        TestReportStatus @default(SUBMITTED)
  refusalReason String?          @db.VarChar(500)
  createdAt     DateTime         @default(now())
  reviewedAt    DateTime?
  screenshots   Screenshot[]

  @@unique([testAppId, testerId])
}

/// Kept in PostgreSQL: a few small images per report, readable only by the tester and the app owner.
model Screenshot {
  id       String     @id @default(cuid())
  reportId String
  report   TestReport @relation(fields: [reportId], references: [id], onDelete: Cascade)
  position Int
  mime     String
  data     Bytes

  @@unique([reportId, position])
}

/**
 * Africa Rise-Up: developers of Africa and the diaspora join forces on a real problem of the continent.
 * Each project has a discussion feed, a members' chat and scheduled events with an external video link (D7).
 */

enum RiseDomain {
  WATER
  HEALTH
  AGRICULTURE
  EDUCATION
  ENERGY
  FINANCE
  OTHER
}

model RiseProject {
  id             String        @id @default(cuid())
  name           String        @db.VarChar(80)
  domain         RiseDomain
  /// One sentence shown on the project card.
  summary        String        @db.VarChar(200)
  problem        String        @db.VarChar(1500)
  /// Skills the project looks for: backend, sécurité, mobile…
  skills         String[]      @default([])
  initiatorId    String
  initiator      User          @relation(fields: [initiatorId], references: [id], onDelete: Cascade)
  /// The members' chat, created with the project.
  conversationId String?       @unique
  conversation   Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  createdAt      DateTime      @default(now())
  members        RiseMember[]
  posts          RisePost[]
  events         RiseEvent[]

  @@index([domain, createdAt])
}

model RiseMember {
  projectId String
  userId    String
  project   RiseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Mobile, Data, Backend…
  skill     String      @default("") @db.VarChar(30)
  joinedAt  DateTime    @default(now())

  @@id([projectId, userId])
  @@index([userId])
}

/// A post in the project's discussion feed. A reply points to its parent post.
model RisePost {
  id        String      @id @default(cuid())
  projectId String
  project   RiseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  authorId  String?
  author    User?       @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parentId  String?
  parent    RisePost?   @relation("RiseReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies   RisePost[]  @relation("RiseReplies")
  body      String      @db.VarChar(2000)
  createdAt DateTime    @default(now())
  hiddenAt  DateTime?

  @@index([projectId, parentId, createdAt])
}

/// A scheduled meeting of the project: a monthly checkpoint, a workshop… held on an external video link.
model RiseEvent {
  id          String      @id @default(cuid())
  projectId   String
  project     RiseProject @relation(fields: [projectId], references: [id], onDelete: Cascade)
  createdById String?
  createdBy   User?       @relation(fields: [createdById], references: [id], onDelete: SetNull)
  title       String      @db.VarChar(100)
  agenda      String      @db.VarChar(600)
  startsAt    DateTime
  minutes     Int
  /// A Google Meet link, required: KABAD hosts no video call.
  meetingUrl  String      @db.VarChar(200)
  /// False when the author chose not to notify the members: no reminder either.
  remind      Boolean     @default(true)
  /// A reminder is sent to the members one hour before.
  remindedAt  DateTime?
  /// Set when the author closes a live room before its planned end.
  endedAt     DateTime?
  createdAt   DateTime    @default(now())

  @@index([projectId, startsAt])
  @@index([startsAt])
}

/**
 * Notifications
 */

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// Short name shown in bold: a member, a group or a hackathon.
  actor     String    @db.VarChar(120)
  /// French text, kept for reading without the dictionaries (e-mails, older notifications).
  text      String    @db.VarChar(300)
  /// Key in messages/<locale>/notifications.json: the screen shows the text in the reader's language.
  key       String?   @db.VarChar(60)
  /// Values of the message: names, amounts, and "at" (ISO date) shown in the time zone "tz".
  params    Json?
  href      String    @db.VarChar(200)
  icon      String    @db.VarChar(20)
  tone      String    @db.VarChar(20)
  readAt    DateTime?
  /// Set when the worker has handled the e-mail of this notification (sent, or not wanted).
  emailedAt DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
  @@index([emailedAt, createdAt])
}

/// Fixed-window counters shared by every web instance.
model RateLimit {
  key     String   @id
  count   Int
  resetAt DateTime
}

/**
 * Account e-mails
 */

enum EmailTokenPurpose {
  VERIFY
  RESET_PASSWORD
}

/// One-time link or code sent by e-mail. Only SHA-256 hashes are stored.
model EmailToken {
  id        String            @id
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  purpose   EmailTokenPurpose
  /// SHA-256 of the 6-digit code typed by the member (VERIFY). Locked after 5 wrong attempts.
  codeHash  String?
  attempts  Int               @default(0)
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime          @default(now())

  @@index([userId, purpose])
}

/// What the team did, kept for accountability.
model AdminAction {
  id        String   @id @default(cuid())
  adminId   String
  admin     User     @relation("AdminActor", fields: [adminId], references: [id], onDelete: Cascade)
  action    String   @db.VarChar(40)
  targetId  String?
  details   String?  @db.VarChar(500)
  createdAt DateTime @default(now())

  @@index([createdAt])
}

/**
 * Voice rooms: live audio events, like a stage with an audience
 */

enum RoomStatus {
  SCHEDULED
  LIVE
  ENDED
}

model VoiceRoom {
  id           String            @id @default(cuid())
  title        String            @db.VarChar(100)
  description  String            @db.VarChar(600)
  hostId       String
  host         User              @relation("RoomHost", fields: [hostId], references: [id], onDelete: Cascade)
  status       RoomStatus        @default(SCHEDULED)
  startsAt     DateTime
  startedAt    DateTime?
  endedAt      DateTime?
  /// Hidden by the moderation team.
  hiddenAt     DateTime?
  createdAt    DateTime          @default(now())
  participants RoomParticipant[]
  interests    RoomInterest[]

  @@index([status, startsAt])
}

enum RoomRole {
  HOST
  SPEAKER
  LISTENER
}

/// Who is (or was) in a room, and with which role. Only HOST and SPEAKER may publish audio.
model RoomParticipant {
  roomId       String
  userId       String
  room         VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  role         RoomRole  @default(LISTENER)
  handRaisedAt DateTime?
  /// Removed by the host: cannot come back into this room.
  removedAt    DateTime?
  joinedAt     DateTime  @default(now())
  leftAt       DateTime?

  @@id([roomId, userId])
  @@index([userId])
}

/// "Remind me": notified when the room goes live.
model RoomInterest {
  roomId    String
  userId    String
  room      VoiceRoom @relation(fields: [roomId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime  @default(now())

  @@id([roomId, userId])
}
